# Existing database connection
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Cloudinary image storage (create a free account at https://cloudinary.com/)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Multi-courier integration example. Replace EXAMPLE with the integration key
# saved on the courier record (uppercase, non-alphanumeric characters become _).
# Keep real values in Vercel Environment Variables; never commit secrets.
COURIER_EXAMPLE_API_URL=https://api.carrier.example
COURIER_EXAMPLE_API_TOKEN=replace_me
COURIER_EXAMPLE_CREATE_PATH=/shipments
COURIER_EXAMPLE_WEBHOOK_SECRET=replace_with_a_long_random_secret

# Add one set of variables per courier, for example FAST_SHIP, LOCAL_COURIER, etc.
# COURIER_FAST_SHIP_API_URL=https://...
# COURIER_FAST_SHIP_API_TOKEN=...
# COURIER_FAST_SHIP_CREATE_PATH=/shipments
# COURIER_FAST_SHIP_WEBHOOK_SECRET=...
