# Session signing secret (generate a different random value for production)
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace_with_a_random_secret_at_least_32_characters
# One-time setup code: enter this once on /setup, then remove this variable after creating the first Admin
INITIAL_SETUP_TOKEN=replace_with_a_different_random_one_time_code

# Existing database connection
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Cloudinary image storage (create a free account at https://cloudinary.com/)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Shipping integration (required before saving carrier API credentials)
# Generate with: openssl rand -base64 32
SHIPPING_CREDENTIALS_ENCRYPTION_KEY=replace_with_base64_32_byte_key
# Password that authorizes changes in the shipping API settings UI
SHIPPING_SETTINGS_PASSWORD=replace_with_a_long_random_password
